post_install() {
  modprobe uinput 2>/dev/null || true
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger --subsystem-match=misc --sysname-match=uinput 2>/dev/null || true
  systemctl --global enable vdstreamer.service >/dev/null 2>&1 || true
  echo "Log out/in (or 'systemctl --user start vdstreamer'), then: vdstreamer account add meta <username>"
}
post_upgrade() { post_install; }
pre_remove() { systemctl --global disable vdstreamer.service >/dev/null 2>&1 || true; }
