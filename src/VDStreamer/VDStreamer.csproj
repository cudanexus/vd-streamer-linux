<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>vdstreamer</AssemblyName>
    <RootNamespace>VDStreamer</RootNamespace>
    <Product>Virtual Desktop Streamer</Product>
    <Company>vd-streamer-linux</Company>
    <Version>1.1.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0414;CS0649;CS1998;CA1416</NoWarn>
    <!-- Vendor assemblies are extracted from the official macOS installer by
         scripts/extract-vendor.sh and are never redistributed with the sources. -->
    <VendorDir Condition="'$(VendorDir)' == ''">$(MSBuildThisFileDirectory)../../build/vendor</VendorDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <!-- Compile against the vendor assemblies but never copy them: at runtime they are
       resolved from the vendor directory (see VendorManager.InstallResolver). -->
  <ItemGroup>
    <VendorReference Include="VirtualDesktop.Core;VirtualDesktop.Net;VirtualDesktop.Interfaces;VirtualDesktop.Mobile.Shared;VirtualDesktop.WCF;VirtualDesktop.FFmpeg;Xenko.VR;Xenko.Core;Xenko.Core.Mathematics;NLog;Newtonsoft.Json;System.Private.ServiceModel;System.ServiceModel.Primitives;System.ServiceModel.Http;FFmpeg.AutoGen;SmartAssembly.Attributes" />
    <Reference Include="@(VendorReference)">
      <HintPath>$(VendorDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Compile-only forwarding facade generated by VendorTool (see CoreLibFacade.cs). -->
    <Reference Include="System.Private.CoreLib">
      <HintPath>$(VendorDir)-ref/System.Private.CoreLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/index.html" LogicalName="index.html" />
  </ItemGroup>

</Project>
